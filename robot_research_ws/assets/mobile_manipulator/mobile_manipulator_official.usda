#usda 1.0
(
    defaultPrim = "MobileManipulator"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "MobileManipulator"
{
    def Xform "MobileBase" (
        prepend references = @../mobile_base/cad_20260912/mobile_base_sim/mobile_base_sim.usda@
    )
    {
        double3 xformOp:translate = (0, 0, 0.15)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        over "Geometry"
        {
            over "base_link"
            {
                def Cube "openarm_mount_plate" (
                    prepend apiSchemas = ["PhysicsCollisionAPI"]
                )
                {
                    color3f[] primvars:displayColor = [(0.32, 0.34, 0.38)]
                    float3 xformOp:scale = (0.125, 0.125, 0.02)
                    double3 xformOp:translate = (0, 0, 0.20)
                    uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
                }
            }
        }
    }

    def Xform "OpenArm" (
        prepend references = @./openarm_bimanual_official/openarm_bimanual.usd@
    )
    {
        double3 xformOp:translate = (0, 0, 0.37)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        # The official standalone asset is world-fixed.  Only this composed
        # layer disables that joint; the vendored source asset stays untouched.
        over "root_joint" (
            active = false
        )
        {
        }
    }

    def Scope "IntegrationJoints"
    {
        def PhysicsFixedJoint "base_to_official_openarm"
        {
            rel physics:body0 = </MobileManipulator/MobileBase/Geometry/base_link>
            rel physics:body1 = </MobileManipulator/OpenArm/openarm_body_link>
            point3f physics:localPos0 = (0, 0, 0.22)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}
