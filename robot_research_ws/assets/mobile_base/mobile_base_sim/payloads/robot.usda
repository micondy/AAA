#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "mobile_base"
    doc = """Generated from Composed Stage of root layer /tmp/tmp54hkp7ys/mobile_base.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_mobile_base_sim_rm2cnsnd/usdex_mobile_base_sim/mobile_base.usdc


Generated from Composed Stage of root layer /tmp/urdf_import_mobile_base_sim_rm2cnsnd/temp_mobile_base_sim/mobile_base_sim.usd
"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "mobile_base" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </mobile_base/Physics/front_left_steer_joint>,
        </mobile_base/Physics/front_right_steer_joint>,
        </mobile_base/Physics/rear_left_steer_joint>,
        </mobile_base/Physics/rear_right_steer_joint>,
        </mobile_base/Physics/front_left_drive_joint>,
        </mobile_base/Physics/front_right_drive_joint>,
        </mobile_base/Physics/rear_left_drive_joint>,
        </mobile_base/Physics/rear_right_drive_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </mobile_base/Geometry/base_link>,
        </mobile_base/Geometry/base_link/front_left_steer_link>,
        </mobile_base/Geometry/base_link/front_left_steer_link/front_left_wheel_link>,
        </mobile_base/Geometry/base_link/front_right_steer_link>,
        </mobile_base/Geometry/base_link/front_right_steer_link/front_right_wheel_link>,
        </mobile_base/Geometry/base_link/rear_left_steer_link>,
        </mobile_base/Geometry/base_link/rear_left_steer_link/rear_left_wheel_link>,
        </mobile_base/Geometry/base_link/rear_right_steer_link>,
        </mobile_base/Geometry/base_link/rear_right_steer_link/rear_right_wheel_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "front_left_steer_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "front_left_wheel_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "front_right_steer_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "front_right_wheel_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "rear_left_steer_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rear_left_wheel_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }

            over "rear_right_steer_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "rear_right_wheel_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        over "front_left_steer_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_left_drive_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_right_steer_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "front_right_drive_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_left_steer_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_left_drive_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_right_steer_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "rear_right_drive_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

