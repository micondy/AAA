over "mobile_base"
{
    over "Physics"
    {
        def MjcActuator "front_left_steer_joint_actuator"
        {
            uniform double mjc:forceRange:max = 100
            uniform double mjc:forceRange:min = -100
            custom rel mjc:target
            prepend rel mjc:target = </mobile_base/Physics/front_left_steer_joint>
        }

        def MjcActuator "front_left_drive_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </mobile_base/Physics/front_left_drive_joint>
        }

