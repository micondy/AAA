Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: RGB
      Topic:
        Value: /sensors/nav_camera/color/image_raw
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: General object instances
      Topic:
        Value: /target_perception/debug/overlay
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Aligned depth
      Topic:
        Value: /sensors/nav_camera/aligned_depth_to_color/image_raw
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: nav_camera_link
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 2.0
      Name: Current View
      Target Frame: nav_camera_link
Window Geometry:
  Height: 900
  Width: 1400
