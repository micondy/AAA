<?xml version="1.0"?>
<package format="3">
  <name>experiment_tools</name>
  <version>0.1.0</version>
  <description>Repeatable rosbag recording and sensor health checks.</description>
  <maintainer email="2637781202@qq.com">micondy</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>launch</exec_depend>
